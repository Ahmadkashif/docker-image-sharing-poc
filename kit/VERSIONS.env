# Pinned tool images, checked live 2026-09-22; re-checked 2026-10-14 on Linux (advisories listed below).
# 2026-10-14 security bumps: buildkit v0.33.0 -> v0.33.1 (GHSA-66hf-6vf5-87hc, GHSA-mgqf-486f-49vp, GHSA-cv6p-7w7g-xjwq,
#   GHSA-fjj4-h6vf-m9hj, GHSA-9728-qjrv-2xh2; all fixed in v0.33.1+), registry 3.1.1 -> 3.1.2 (GHSA-685w-q87j-wqw3: the
#   pull-through proxy did not verify fetched manifests against the requested digest; fixed in 3.1.2).
# Bump deliberately, then re-run tests/validate.sh. For production, pin by digest too (tag@sha256:...).
# Every image here is multi-arch (linux/amd64 + linux/arm64), so the same file works on the Mac and the server.
REGISTRY_IMAGE=registry:3.1.2
ZOT_IMAGE=ghcr.io/project-zot/zot:v2.1.21
BUILDKIT_IMAGE=moby/buildkit:v0.33.1
COSIGN_IMAGE=ghcr.io/sigstore/cosign/cosign:v3.1.3
GRYPE_IMAGE=anchore/grype:v0.119.0
SYFT_IMAGE=anchore/syft:v1.52.0
SKOPEO_IMAGE=quay.io/skopeo/stable:v1.22.3
ORAS_IMAGE=ghcr.io/oras-project/oras:v1.3.4
REGCTL_IMAGE=ghcr.io/regclient/regctl:v0.11.6
HTPASSWD_IMAGE=httpd:2.4-alpine
