# P2 — server has NO internet, but the Mac reaches it over the LAN/VPN. Everything the server needs is pushed in:
# app images, base images (via the Mac-side build), and the tool images (cosign, grype) under $REGISTRY/tools/*.
PROFILE_DESC="LAN-only amd64 server (no internet); self-hosted Zot on the server; tools mirrored into the registry"

# --- target server -----------------------------------------------------------------------------------------------
SERVER_PLATFORM=linux/amd64            # what the server runs (detect with: bin/detect-host.sh on the server)
SERVER_SSH=deploy@app-server.example.internal   # user@host, or alias from ~/.ssh/config; "" = no SSH (deploy by CI)
SERVER_SSH_PORT=22
SERVER_INTERNET=no                     # yes | no

# --- build -------------------------------------------------------------------------------------------------------
BUILD_PLATFORMS=linux/amd64,linux/arm64   # publish both: server gets amd64, Apple Silicon devs run arm64 natively
BUILDER_MODE=local                     # local (Mac, QEMU for amd64) | remote (build ON the server) | multinode
BUILDER_DRIVER_OPTS=                   # extra --driver-opt k=v,... for the buildx builder
SBOM=true                              # attach an SPDX SBOM attestation to the index
PROVENANCE=mode=max                    # min | max | false
CACHE=registry                         # registry (shared <name>:buildcache) | local | none

# --- transport ---------------------------------------------------------------------------------------------------
TRANSPORT=registry                     # registry | ssh-load | oci-archive
REGISTRY_KIND=self-hosted            # company | self-hosted
REGISTRY_IMPL=zot                      # zot (RBAC, online GC, retention) | distribution (minimal)
REGISTRY_HOST=registry.example.internal
REGISTRY_PORT=5443
REGISTRY_NAMESPACE=team                # repo prefix
REGISTRY_CA_FILE=certs/ca.crt           # internal CA made by registry/mkcerts.sh (or the company CA)
MIRROR_ENABLED=no                      # a pull-through mirror needs internet on its host; push base images instead
MIRROR_HOST=
MIRROR_PORT=

# --- security ----------------------------------------------------------------------------------------------------
SIGNING=cosign-key                     # cosign-key | none   (swap to keyless/KMS if the company has Sigstore/KMS)
COSIGN_KEY=keys/cosign.key
COSIGN_PUB=keys/cosign.pub
SCAN_FAIL_ON=high                      # negligible | low | medium | high | critical | "" (gate off)
SCAN_ONLY_FIXED=yes                    # yes = gate only on vulns that HAVE a fix (actionable); no = any match
VERIFY_ON_SERVER=yes                   # cosign verify on the server before pulling

# --- tools -------------------------------------------------------------------------------------------------------
TOOLS_DOCKER_NETWORK=                  # docker network for tool containers ("" = default bridge)
TOOLS_FROM_REGISTRY=yes                # server pulls cosign/grype from $REGISTRY/tools/* (img mirror-tools)

# --- minimum requirements (checked by bin/detect-host.sh --check) ------------------------------------------------
MIN_CLIENT_DOCKER=28.0                 # API 1.48: docker save/load --platform
MIN_SERVER_DOCKER=25.0                 # OCI-layout docker load, current security fixes; 28.0+ recommended
MIN_BUILDX=0.13                        # rewrite-timestamp, cache/attestation behaviour used here
REQUIRE_SERVER_CONTAINERD_STORE=no     # only needed if the server must keep multi-arch indexes locally
MIN_SERVER_DISK_GB=20

# --- self-hosted registry settings (rendered into build/<profile>/registry/) --------------------------------------
REGISTRY_BIND=10.0.0.10                # LAN/VPN address to publish on. Never 0.0.0.0 on an internet-facing host.
REGISTRY_PUSH_USERS=ci-push,dev-alice   # read+create+update
REGISTRY_PULL_USERS=server-pull         # read only (what the server logs in with)
REGISTRY_ADMIN_USERS=registry-admin     # + delete
RETENTION_KEEP_RECENT=30               # keep this many most-recently-pushed tags per repo (+ all v* release tags)
RETENTION_DRY_RUN=true                 # log what retention WOULD delete; flip to false after reviewing
