# verify-linux P3 — air-gap leg of the Linux verification lab (../lab-linux/). Outside: the amd64 build host writes an
# OCI archive. Inside: the air-gapped server VM runs its own Zot (from `img bundle-tools`) and deploys to itself.
# Lab names below are NOT defaults for anything.
PROFILE_DESC="Linux verification lab, P3: OCI archive on media; inside Zot + deploy on an air-gapped KVM VM"
SERVER_PLATFORM=linux/amd64
SERVER_SSH=deploy@localhost              # inside: the operator deploys on the same VM
SERVER_SSH_PORT=22
SERVER_INTERNET=no
BUILD_PLATFORMS=linux/amd64,linux/arm64
BUILDER_MODE=local
BUILDER_NAME=img-vmlab-p3-builder
SBOM=true
PROVENANCE=mode=max
CACHE=local
TRANSPORT=oci-archive
REGISTRY_KIND=self-hosted
REGISTRY_IMPL=zot
REGISTRY_HOST=zot.inside                 # inside registry (on the air-gapped VM; /etc/hosts there)
REGISTRY_PORT=5443
REGISTRY_NAMESPACE=team
REGISTRY_CA_FILE=certs/ca.crt            # the INSIDE CA: created inside with registry/mkcerts.sh
MIRROR_ENABLED=no
SIGNING=cosign-key
COSIGN_KEY=keys/cosign.key
COSIGN_PUB=keys/cosign.pub
SCAN_FAIL_ON=high
SCAN_ONLY_FIXED=yes
VERIFY_ON_SERVER=no                      # trust established at import (sha256 + verify-blob)
TOOLS_DOCKER_NETWORK=host                # inside: tools reach 127.0.0.1-published zot.inside via the VM's /etc/hosts
TOOLS_FROM_REGISTRY=no                   # tools arrive via `img bundle-tools` + docker load
REGISTRY_BIND=127.0.0.1
REGISTRY_PUBLISH=127.0.0.1:5443
REGISTRY_PUSH_USERS=ci-push
REGISTRY_PULL_USERS=server-pull
REGISTRY_ADMIN_USERS=registry-admin
RETENTION_KEEP_RECENT=30
RETENTION_DRY_RUN=true
MIN_CLIENT_DOCKER=28.0
MIN_SERVER_DOCKER=25.0
MIN_BUILDX=0.13
REQUIRE_SERVER_CONTAINERD_STORE=no
MIN_SERVER_DISK_GB=10
