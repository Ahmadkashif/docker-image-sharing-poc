# verify-linux — the Linux verification profile: an amd64 Linux build machine (Docker Engine, no QEMU/binfmt) and
# disposable Ubuntu 24.04 + Docker Engine 29 KVM VMs as servers (../lab-linux/). Lab names below are NOT defaults.
# The registry runs on the build host, published on loopback only, and joins the lab network the VMs are routed to.
PROFILE_DESC="Linux verification lab: amd64 build host, real KVM server VMs (classic/containerd/offline), Zot TLS+RBAC"
SERVER_PLATFORM=linux/amd64
SERVER_SSH=deploy@srv-cstore             # lab ssh alias (lab ssh_config); --set SERVER_SSH=deploy@srv-classic etc.
SERVER_SSH_PORT=22
SERVER_INTERNET=yes
BUILD_PLATFORMS=linux/amd64,linux/arm64
BUILDER_MODE=local
BUILDER_NAME=img-vmlab-builder
BUILDER_DRIVER_OPTS=network=img-vmlab    # builder joins the lab network to reach zot.vmlab
BUILDER_REMOTE_DRIVER_OPTS=network=host  # remote builder uses the server VM's resolver
SBOM=true
PROVENANCE=mode=max
CACHE=registry
TRANSPORT=registry
REGISTRY_KIND=self-hosted
REGISTRY_IMPL=zot
REGISTRY_HOST=zot.vmlab
REGISTRY_PORT=5443
REGISTRY_NAMESPACE=team
REGISTRY_CA_FILE=certs/ca.crt
MIRROR_ENABLED=yes
MIRROR_HOST=mirror.vmlab
MIRROR_PORT=5444
SIGNING=cosign-key
COSIGN_KEY=keys/cosign.key
COSIGN_PUB=keys/cosign.pub
SCAN_FAIL_ON=high
SCAN_ONLY_FIXED=yes
VERIFY_ON_SERVER=yes
TOOLS_DOCKER_NETWORK=img-vmlab
TOOLS_FROM_REGISTRY=no
REGISTRY_BIND=127.0.0.1
REGISTRY_PUBLISH=127.0.0.1:5443          # loopback only on the build host; VMs reach it over the lab network
MIRROR_PUBLISH=127.0.0.1:5444
REGISTRY_NETWORK=img-vmlab
REGISTRY_NETWORK_EXTERNAL=true
REGISTRY_PUSH_USERS=ci-push
REGISTRY_PULL_USERS=server-pull
REGISTRY_ADMIN_USERS=registry-admin
RETENTION_KEEP_RECENT=30
RETENTION_DRY_RUN=true
MIN_CLIENT_DOCKER=28.0
MIN_SERVER_DOCKER=25.0
MIN_BUILDX=0.13
REQUIRE_SERVER_CONTAINERD_STORE=no
MIN_SERVER_DISK_GB=10
