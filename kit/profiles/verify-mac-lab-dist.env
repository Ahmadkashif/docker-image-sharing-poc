# verify — the verification profile: Apple Silicon Mac + Docker Desktop, simulated server (dind + sshd) on a lab
# network. Used only to prove the templates end-to-end (../phase-4/). Lab names below are NOT defaults for anything.
PROFILE_DESC="Verification lab, Distribution registry:3 variant (htpasswd, no RBAC)"
SERVER_PLATFORM=linux/amd64
SERVER_SSH=deploy@dis-sim
SERVER_SSH_PORT=22
SERVER_INTERNET=yes
BUILD_PLATFORMS=linux/amd64,linux/arm64
BUILDER_MODE=local
BUILDER_NAME=dis-builder-dist
BUILDER_DRIVER_OPTS=network=dis-lab          # lab: builder joins the lab network to reach zot.lab
BUILDER_REMOTE_DRIVER_OPTS=network=host      # lab: remote builder uses the sim server's resolver
SBOM=true
PROVENANCE=mode=max
CACHE=registry
TRANSPORT=registry
REGISTRY_KIND=self-hosted
REGISTRY_IMPL=distribution
REGISTRY_HOST=registry.lab
REGISTRY_PORT=5443
REGISTRY_NAMESPACE=team
REGISTRY_CA_FILE=certs/ca.crt
MIRROR_ENABLED=no
MIRROR_HOST=
MIRROR_PORT=
SIGNING=cosign-key
COSIGN_KEY=keys/cosign.key
COSIGN_PUB=keys/cosign.pub
SCAN_FAIL_ON=high
SCAN_ONLY_FIXED=yes                    # yes = gate only on vulns that HAVE a fix (actionable); no = any match
VERIFY_ON_SERVER=yes
TOOLS_DOCKER_NETWORK=dis-lab
TOOLS_FROM_REGISTRY=no
REGISTRY_BIND=127.0.0.1
REGISTRY_PUBLISH=127.0.0.1:                  # random loopback port (lab)
MIRROR_PUBLISH=127.0.0.1:
REGISTRY_NETWORK=dis-lab
REGISTRY_NETWORK_EXTERNAL=true
REGISTRY_PUSH_USERS=ci-push
REGISTRY_PULL_USERS=server-pull
REGISTRY_ADMIN_USERS=registry-admin
RETENTION_KEEP_RECENT=30
RETENTION_DRY_RUN=true
MIN_CLIENT_DOCKER=28.0
MIN_SERVER_DOCKER=25.0
MIN_BUILDX=0.13
REQUIRE_SERVER_CONTAINERD_STORE=no
MIN_SERVER_DISK_GB=5
